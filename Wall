-- กดปุ่มสลับสถานะเปิด/ปิด Wall Hop
ToggleBtn.MouseButton1Click:Connect(function()
    wallHopEnabled = not wallHopEnabled
    if wallHopEnabled then
        ToggleBtn.Text = "Wall Hop : เปิด"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 0) -- สีเขียวตอนเปิด
    else
        ToggleBtn.Text = "Wall Hop : ปิด"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(180, 0, 0) -- สีแดงตอนปิด
    end
end)

-- ระบบ Wall Hop
local function doWallHop()
    if not wallHopEnabled then return end
    
    local char = LP.Character
    if not char then return end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    
    if hrp and humanoid then
        local raycastParams = RaycastParams.new()
        raycastParams.FilterAncestorsCases = {char}
        raycastParams.FilterType = Enum.RaycastFilterType.Exclude

        local directions = {
            hrp.CFrame.LookVector,
            -hrp.CFrame.LookVector,
            hrp.CFrame.RightVector,
            -hrp.CFrame.RightVector
        }

        local isTouchingWall = false
        for _, dir in pairs(directions) do
            local ray = workspace:Raycast(hrp.Position, dir * 2.5, raycastParams)
            if ray then
                isTouchingWall = true
                break
            end
        end

        if isTouchingWall then
            humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end
end

UserInputService.JumpRequest:Connect(function()
    doWallHop()
end)

print("Wall Hop Rainbow UI Loaded!")
